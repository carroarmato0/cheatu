# Maintainer: Christophe Vanlancker <carroarmato0@gmail.com>
pkgname=cheatu
pkgver=1.1.0
pkgrel=1
pkgdesc="Memory scanner and cheat tool for games, inspired by Cheat Engine and scanmem"
arch=('x86_64')
url="https://github.com/carroarmato0/cheatu"
license=('MIT')
depends=('gcc-libs' 'glibc'
         # dlopened by the GUI's windowing stack, so `ldd` shows none of them
         'fontconfig' 'libglvnd' 'libx11' 'libxcb' 'libxcursor' 'libxi'
         'libxkbcommon' 'libxkbcommon-x11' 'libxrender' 'wayland'
         # pkexec, for attaching to a process the user does not own
         'polkit')
optdepends=('noto-fonts-cjk: CJK text rendering in the GUI')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('71da4074587595eda4a5b9db3f3a7e541bc90ebc2e59cf380a0ed8edeca7e610')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --workspace
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --release --workspace
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/cheatu "$pkgdir/usr/bin/cheatu"
    install -Dm755 target/release/cheatu-gui "$pkgdir/usr/bin/cheatu-gui"
    install -Dm755 target/release/cheatu-inject "$pkgdir/usr/bin/cheatu-inject"

    install -Dm644 packaging/assets/io.github.carroarmato0.cheatu.desktop \
        "$pkgdir/usr/share/applications/io.github.carroarmato0.cheatu.desktop"
    install -Dm644 packaging/assets/io.github.carroarmato0.cheatu.metainfo.xml \
        "$pkgdir/usr/share/metainfo/io.github.carroarmato0.cheatu.metainfo.xml"
    install -Dm644 packaging/assets/io.github.carroarmato0.cheatu.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.carroarmato0.cheatu.svg"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
